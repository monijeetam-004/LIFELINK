# Base URL of the LifeLink API. No trailing slash.
VITE_API_URL=http://localhost:8000

# Optional map tile URL template (default: OpenStreetMap). When tiles cannot
# load, the map shows an explicit "tiles could not be loaded" banner and still
# draws its markers.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
