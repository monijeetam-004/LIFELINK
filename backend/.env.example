# ---- Core ----
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string

# ---- Database ----
DATABASE_URL=postgresql+psycopg://lifelink:lifelink@localhost:5432/lifelink
# Used by the test suite (tests/conftest.py). Must be a DISPOSABLE database.
TEST_DATABASE_URL=postgresql+psycopg://lifelink:lifelink@localhost:5432/lifelink_test

# ---- Redis / queue ----
REDIS_URL=redis://localhost:6379/0
# When true, emails are delivered inline instead of via the RQ worker
# (handy for local dev without running a worker). Keep false in production.
RQ_SYNC=false

# ---- Session cookie ----
SESSION_COOKIE_NAME=lifelink_session
SESSION_COOKIE_SECURE=false          # set true in production (HTTPS)
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_TTL_SECONDS=1209600          # 14 days

# ---- CORS / frontend ----
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# ---- Mail ----  (full guide: docs/LIFELINK_EMAIL.md)
# The API and the RQ worker read the SAME variables; both log
# "mail transport: <provider> <host>:<port> ..." at start-up (never the password).
#
# MODE A -- Mailpit (default, development; nothing leaves your machine)
#   docker compose: COMPOSE_PROFILES=mailpit starts the Mailpit container and,
#   with MAIL_HOST left unset, the API/worker send to it (UI: http://localhost:8025).
#   Running the API directly on your machine: leave MAIL_HOST unset (defaults
#   to localhost) and run Mailpit on localhost:1025.
COMPOSE_PROFILES=mailpit
# MAIL_HOST=
MAIL_PORT=1025
MAIL_STARTTLS=false
MAIL_USE_SSL=false
MAIL_FROM=no-reply@lifelink.local
MAIL_USERNAME=
MAIL_PASSWORD=
#
# MODE B -- real Gmail SMTP (replace the Mode A values above with these;
# delete the COMPOSE_PROFILES line if you don't also want Mailpit running):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_STARTTLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=your-gmail-address@gmail.com
# MAIL_PASSWORD=<16-character Google App Password>
# MAIL_FROM=your-gmail-address@gmail.com
#
# MAIL_PASSWORD must be a Google "App Password" (myaccount.google.com/apppasswords,
# needs 2-Step Verification), never your normal Gmail password. Put it ONLY in
# your local, git-ignored .env (or your deployment's secret store) -- never in
# this file, never in source control. The app refuses to start with Gmail
# selected but no credentials, with credentials but no TLS, or with TLS
# misconfigured (port 587+STARTTLS or 465+SSL). Check delivery with:
#   python -m scripts.send_test_email you@example.com

# ---- Auth tuning ----
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_OTP_TTL_SECONDS=600
PASSWORD_RESET_MAX_ATTEMPTS=5

# ---- Registration capacity (Phase 11) ----
# IMPORTANT: this is a PER-ROLE limit, not a total. Each of the four
# self-registerable roles (PATIENT, FAMILY, DONOR, HOSPITAL) gets its own
# independent cap of this many accounts created through POST /auth/register
# -- so MAX_ACCOUNTS=100 allows up to 400 new accounts total (100 of each
# role), not 100 combined. ADMIN cannot self-register at all and never
# consumes any of this. Must be a positive integer -- the app refuses to
# start otherwise. Existing seeded/demo users are never retroactively
# counted against this (see README.md).
MAX_ACCOUNTS=100

# ---- Object storage (MinIO in dev) — also used for verification-document uploads ----
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=lifelink
S3_SECRET_KEY=lifelink-secret
S3_BUCKET=lifelink-dev
S3_PRESIGN_EXPIRY_SECONDS=900
# Leave the four S3_* values above unset/empty to use the local-disk storage
# fallback instead (used automatically in tests; fine for solo dev too).

# ---- Malware scanning of uploaded documents ----
# clamd = ClamAV daemon (docker compose starts one as `clamav`; required when
# ENVIRONMENT=production). none = scanning disabled (dev only; documents are
# recorded as "not scanned"). A scan error never counts as clean: the file is
# quarantined and retried (see docs/LIFELINK_MALWARE_SCANNING.md).
DOCUMENT_SCANNER=none
CLAMD_HOST=localhost
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=15
DOCUMENT_RESCAN_DELAY_SECONDS=300

# ---- Audit chain: HMAC-signed checkpoints outside the database ----
# Optional for a native dev run; REQUIRED by docker-compose.yml (audit E4,
# 2026-10-31), which reads AUDIT_CHECKPOINT_KEY from here and sets the path.
# Generate a key:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real key. See docs/AUDIT_CHECKPOINTS.md (setup, rotation, limits).
# AUDIT_CHECKPOINT_REQUIRED=true makes the API refuse to start without them.
AUDIT_CHECKPOINT_REQUIRED=false
AUDIT_CHECKPOINT_INTERVAL_MINUTES=15
# Both must be set together (or both left empty = disabled). The key must be
# >= 32 chars, differ from SECRET_KEY, and live in a secret store the database
# credentials cannot read. The path must be on storage the database
# credentials cannot write (separate volume/host; append-only/WORM ideally).
# Write: python -m scripts.audit_checkpoint write   (schedule hourly)
# Check: python -m scripts.audit_checkpoint verify  (schedule daily)
AUDIT_CHECKPOINT_KEY=
AUDIT_CHECKPOINT_KEY_ID=k1
AUDIT_CHECKPOINT_RETIRED_KEYS=
AUDIT_CHECKPOINT_PATH=

# ---- Certificates ----
CERTIFICATE_DOWNLOAD_TTL_SECONDS=600

# ---- Additional rate limits (optional — sensible defaults are baked in;
#      override as a JSON [limit, window_seconds] pair if you need to) ----
# RL_CHANGE_PASSWORD_ACCOUNT=[5,3600]
# RL_VERIFICATION_SUBMIT_ACCOUNT=[5,3600]

# ---- Identity/facility verification document uploads ----
VERIFICATION_MAX_FILE_BYTES=10485760
VERIFICATION_MAX_FILES=5
VERIFICATION_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png

# ---- Neo4j graph engine (resource discovery / pathway traversal) ----
# All four are optional. Leave unset to run with the graph engine disabled --
# the pathway planner then searches the transport routes stored in
# PostgreSQL (hop-bounded, operational routes only) and reports
# pathway_source=RELATIONAL_ROUTES; a graph answer, when Neo4j IS configured,
# is used only if PostgreSQL confirms every route in it. Never commit real
# values here or anywhere else in the repo.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT_SECONDS=5
# Aura console metadata only -- NOT read by the app (Settings ignores unknown
# keys). Harmless to leave unset; kept here only so a real .env that has them
# has somewhere consistent to put them.
AURA_INSTANCEID=
AURA_INSTANCENAME=

# ---- SMS (MSG91) -- DISABLED in this deployment, on purpose ----
# See LIFELINK_SMS_STATUS.md before touching any of this. SMS is off by
# default and does not need to be configured for local dev, tests, the
# frontend, in-app notifications, or emergency workflows -- all of that
# works with every value below left blank, exactly as shipped.
#
# MSG91_ENABLED is the master switch; everything else is inert while it's
# false. Leave it false unless you have genuinely registered a MSG91
# account, generated a real auth key, and (for India) completed DLT
# template/sender registration -- see LIFELINK_SMS_PROVIDER.md for what
# that actually involves. Never commit real values here or anywhere else
# in the repo.
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=
MSG91_TIMEOUT_SECONDS=10
# Optional per-template Flow ID overrides, as a JSON object mapping template
# key -> Flow ID (see app/models/enums.py:SmsTemplateKey for the keys).
# Only needed once you're sending more than one distinctly-worded template.
MSG91_TEMPLATE_FLOW_MAP=
# Region used to parse a phone number typed without a country code.
SMS_DEFAULT_REGION=IN

# SMS provider: msg91 (real; needs MSG91_ENABLED=true and the keys above) or
# console (development only: records the message as LOGGED_ONLY -- never
# "sent" -- and is refused when ENVIRONMENT=production).
SMS_PROVIDER=msg91

# ---- Emergency pathway planner (gap elimination; all are assumptions, see
#      docs/final-verification/RESEARCH_LIMITATIONS.md) ----
PATHWAY_HANDLING_MINUTES=30
PATHWAY_DEADLINE_RISK_MINUTES=15
PATHWAY_MAX_HOPS=6
PATHWAY_MAX_BACKUPS=3
# Donor alerts/ranking ignore donors farther than this (ADMIN override is audited).
MAX_DONOR_DISTANCE_KM=50
# Hospitals alerted for an emergency: verified, within this radius (or same
# city), holding compatible usable stock -- plus the target facility.
HOSPITAL_ALERT_RADIUS_KM=50
DEADLINE_WARNING_MINUTES=30
DEADLINE_MONITOR_INTERVAL_SECONDS=60
TELEMETRY_MAX_GAP_MINUTES=30
# Optional Nominatim-compatible geocoder for free-text emergency addresses.
# OFF by default: patient address text is not sent to a third party unless
# you set this. Without it, only user coordinates, the target facility or a
# labelled city-level estimate are used -- never an invented location.
GEOCODER_URL=
GEOCODER_TIMEOUT_SECONDS=3
# Reported by /pathways/config and on every research page.
DATA_IS_SYNTHETIC=true

# ---- Donor matching and shortlist (2026-10-31) ----
# Eligibility interval policy: IN_DCR_2020 (India, 120 days applied) or
# US_21CFR630 (56 days). A pre-screen only -- clinical review pending.
DONOR_ELIGIBILITY_POLICY=IN_DCR_2020
# A request with no city/coordinates alerts no donor unless this is true.
DONOR_ALERT_ALLOW_UNSCOPED=false
DONOR_LOCATION_STALE_DAYS=90
# broadcast (open alert to every eligible donor in range) or shortlist
# (contact ranked donors in bounded batches only).
DONOR_ALERT_MODE=broadcast
SHORTLIST_CONTACT_MULTIPLIER=2
SHORTLIST_MAX_BATCH=10
SHORTLIST_RESPONSE_TIMEOUT_MINUTES=30
SHORTLIST_RESPONSE_TIMEOUT_MINUTES_CRITICAL=10
# Unified Donor Priority Score (docs/UNIFIED_DONOR_PRIORITY.md). Provisional
# engineering weights: a ranking measure, not a probability of donation.
# Validated at start-up (finite, >= 0, positive sum) and normalised.
PRIORITY_WEIGHT_AVAILABILITY=0.25
PRIORITY_WEIGHT_RESPONSE=0.15
PRIORITY_WEIGHT_ACCEPTANCE=0.10
PRIORITY_WEIGHT_DISTANCE=0.20
PRIORITY_WEIGHT_ACTIVITY=0.05
PRIORITY_WEIGHT_FRESHNESS=0.10
PRIORITY_WEIGHT_VERIFICATION=0.15
# Below this share of observed evidence the score is reported as unavailable.
PRIORITY_MIN_COVERAGE=0.30
# Demo-only response simulator for SYNTHETIC donors. Never in production.
DEMO_MODE=false
